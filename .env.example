# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.
APP_ENV=dev                         # dev | prod  (en prod JWT_SECRET es obligatorio y se activa HSTS)
DATABASE_URL=sqlite:///./aquaplants.db
# Nube (PostgreSQL): DATABASE_URL=postgresql://usuario:clave@host:5432/aquaplants
JWT_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio   # python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_MINUTOS=60
ADMIN_EMAIL=admin@aquaplants.cl
ADMIN_PASSWORD=                     # si se deja vacía se genera una y se imprime en el log, una sola vez
SEED_DEMO=1                         # 1 = crea usuarios y datos de demostración al iniciar con la BD vacía
CORS_ORIGINS=                       # vacío = solo mismo origen (el frontend se sirve desde la misma app)
RATE_LIMIT_POR_MIN=240
OFFLINE_SEGUNDOS=90
BACKUP_DIR=./respaldos
BACKUP_KEY=                         # opcional: clave Fernet para cifrar respaldos
BACKUP_AUTO=1
BACKUP_HORA=03:00                   # hora UTC del respaldo diario
